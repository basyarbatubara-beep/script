-- ==================== CORE API & TELEPORT LOGIC ====================
local isQuerying = false

local function performRequest(url)
    local requestMethod = (syn and syn.request) or (http and http.request) or request or http_request
    if typeof(requestMethod) == "function" then
        local ok, res = pcall(requestMethod, {
            Url = url,
            Method = "GET",
            Headers = {
                ["User-Agent"] = "Roblox/WinInet",
                ["Accept"] = "application/json"
            }
        })
        if ok and res and res.Body then
            return res.Body, res.StatusCode
        end
    end

    if typeof(game.HttpGet) == "function" then
        local ok, body = pcall(function()
            return game:HttpGet(url)
        end)
        if ok and body then
            return body, 200
        end
    end

    return nil, 0
end

local function fetchServerPage(cursor)
    local query = (cursor and cursor ~= "") and ("&cursor=" .. cursor) or ""
    local url = "https://games.roblox.com/v1/games/" .. tostring(PlaceId) .. "/servers/Public?sortOrder=Asc&limit=" .. tostring(Config.SearchLimit) .. query

    local raw, status = performRequest(url)
    if not raw then
        return nil, "HTTP Transport Failed"
    end

    if status == 429 then
        return nil, "Rate limit reached (429)"
    end

    local success, decoded = pcall(function()
        return HttpService:JSONDecode(raw)
    end)

    if not success or not decoded or not decoded.data then
        return nil, "JSON Parsing Exception"
    end

    return decoded, nil
end

