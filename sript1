-- Auto-Hop Action (Lowest population join)
local function executeQuickHop()
    if isQuerying then return end
    isQuerying = true
    AutoHopBtn.Text = "Scanning Cluster..."
    setStatus("Locating optimal low-pop instance...", Colors.Warning)

    task.spawn(function()
        local cursor = nil
        local candidates = {}
        local fallbackLowest = nil
        local fallbackServer = nil

        for page = 1, Config.MaxPages do
            setStatus(string.format("Scanning halaman %d...", page), Palette.Yellow)
            local result, err = getServersPage(cursor)
            setStatus(string.format("Scanning cluster page %d...", page), Colors.Warning)
            local result, err = fetchServerPage(cursor)

            if not result then
                setStatus("Error: " .. (err or "Gagal fetch"), Palette.Red)
                setStatus("Search error: " .. (err or "retry"), Colors.Danger)
                break
            end

            for _, server in ipairs(result.data) do
                local playing = tonumber(server.playing) or 0
                local maxP = tonumber(server.maxPlayers) or 0
                local sId = tostring(server.id)
            for _, s in ipairs(result.data) do
                local p = tonumber(s.playing) or 0
                local maxP = tonumber(s.maxPlayers) or 0
                local sId = tostring(s.id)

                if sId ~= CurrentJobId and playing > 0 and playing < maxP then
                    if not fallbackLowest or playing < (fallbackLowest.playing or 999) then
                        fallbackLowest = server
                if sId ~= CurrentJobId and p > 0 and p < maxP then
                    if not fallbackServer or p < (fallbackServer.playing or 999) then
                        fallbackServer = s
                    end

                    if playing >= Config.MinPlayers and playing <= Config.MaxPlayers then
                        table.insert(candidates, server)
                    if p >= Config.MinPlayers and p <= Config.MaxPlayers then
                        table.insert(candidates, s)
                    end
                end
            end

            if #candidates > 0 then
                break
            end
            if #candidates > 0 then break end

            cursor = result.nextPageCursor
            if not cursor then
                break
            end
            if not cursor then break end

            task.wait(0.18 + math.random() * 0.1)
        end

        -- Smart fallback jika target filter pasif tidak menemukan server
        if #candidates == 0 and fallbackLowest then
            table.insert(candidates, fallbackLowest)
        if #candidates == 0 and fallbackServer then
            table.insert(candidates, fallbackServer)
        end

        if #candidates == 0 then
            setStatus("Tidak ada server sepi saat ini. Coba lagi nanti.", Palette.Red)
            isSearching = false
            QuickJoinBtn.Text = "⚡ Auto-Join Tersepi"
            setStatus("No alternative servers located. Try raising filter.", Colors.Danger)
            isQuerying = false
            AutoHopBtn.Text = "Hop to Smallest Server"
            return
        end

        table.sort(candidates, function(a, b)
            return (a.playing or 0) < (b.playing or 0)
        end)

        -- Coba kandidat berurutan jika ada kegagalan teleport
        for _, target in ipairs(candidates) do
            setStatus(string.format("Ditemukan server (%d pemain)! Menghubungkan...", target.playing), Palette.Green)
            local success = pcall(function()
            setStatus(string.format("Connecting to target instance (%d players)...", target.playing), Colors.Success)
            local ok = pcall(function()
                TeleportService:TeleportToPlaceInstance(PlaceId, target.id, LocalPlayer)
            end)

            if success then
                task.wait(Config.RetryDelay + 2)
            if ok then
                task.wait(Config.RetryDelay + 1)
            else
                setStatus("Gagal ke server itu, mencoba alternatif...", Palette.Yellow)
                setStatus("Connection timed out, cycling candidate...", Colors.Warning)
                task.wait(Config.RetryDelay)
            end
        end

        isSearching = false
        QuickJoinBtn.Text = "⚡ Auto-Join Tersepi"
        isQuerying = false
        AutoHopBtn.Text = "Hop to Smallest Server"
    end)
end

