            BackgroundTransparency = isCurrent and 0 or 1,
            BackgroundColor3 = isCurrent and Colors.SurfaceRaised or Color3.fromRGB(0, 0, 0),
            TextColor3 = isCurrent and Colors.TextPrimary or Colors.TextMuted
        }):Play()
    end
end

