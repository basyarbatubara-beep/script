local function switchTab(tabName)
    activeTab = tabName
    for name, page in pairs(TabPages) do
        page.Visible = (name == tabName)
    end
    for name, btn in pairs(TabButtons) do
        local isCurrent = (name == tabName)
        TweenService:Create(btn, TweenInfo.new(0.15), {
            BackgroundTransparency = isCurrent and 0 or 1,
            BackgroundColor3 = isCurrent and Colors.SurfaceRaised or Color3.fromRGB(0, 0, 0),
            TextColor3 = isCurrent and Colors.TextPrimary or Colors.TextMuted
        }):Play()
    end
end

