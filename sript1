-- Steal an Egg | Small Server Finder
-- Works with Roblox's PlaceId for "Steal an Egg"

local HttpService = game:GetService("HttpService")
local TeleportService = game:GetService("TeleportService")

-- ══════════════════════════════════════
--         CONFIGURATION
-- ══════════════════════════════════════
local PLACE_ID = 6514268928 -- Steal an Egg Place ID (update if wrong)
local MAX_PLAYERS_FILTER = 5 -- Only show servers with <= this many players
local SERVERS_TO_FETCH = 100 -- How many servers to scan per page

-- ══════════════════════════════════════
--         SERVER FETCHER
-- ══════════════════════════════════════
local function getServers(cursor)
    local url = string.format(
        "https://games.roblox.com/v1/games/%d/servers/Public?sortOrder=Asc&limit=%d%s",
        PLACE_ID,
        SERVERS_TO_FETCH,
        cursor and ("&cursor=" .. cursor) or ""
    )

    local success, response = pcall(function()
        return HttpService:JSONDecode(game:HttpGet(url))
    end)

    if success and response then
        return response
    else
        warn("[ServerFinder] Failed to fetch servers.")
        return nil
    end
end

-- ══════════════════════════════════════
--         FILTER SMALL SERVERS
-- ══════════════════════════════════════
local function findSmallServers()
    local smallServers = {}
    local cursor = nil
    local page = 1

    print("[ServerFinder] Scanning servers... Please wait.")

    repeat
        local data = getServers(cursor)
        if not data or not data.data then break end

        for _, server in ipairs(data.data) do
            if server.playing <= MAX_PLAYERS_FILTER and server.playing > 0 then
                table.insert(smallServers, {
                    jobId    = server.id,
                    players  = server.playing,
                    maxPlayers = server.maxPlayers,
                    ping     = server.ping or "N/A",
                    fps      = server.fps or "N/A"
                })
            end
        end

        cursor = data.nextPageCursor
        page = page + 1

        task.wait(0.5) -- Rate limit protection

    until not cursor or page > 5 -- Limit to 5 pages

    return smallServers
end

