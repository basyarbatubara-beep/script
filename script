local function createTabButton(name, label, index)
    local btn = Instance.new("TextButton")
    btn.Name = "Tab_" .. name
    btn.Size = UDim2.new(0.333, -3, 1, -4)
    btn.Position = UDim2.new((index - 1) * 0.333, 2, 0, 2)
    btn.BackgroundColor3 = (name == activeTab) and Colors.SurfaceRaised or Color3.fromRGB(0, 0, 0)
