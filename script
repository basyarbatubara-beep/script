-- ROBLOX GAMES API ENGINE (100% REAL LIVE SERVERS)
-- ================================================================================
local function fetchRobloxServers(cursorToLoad, isAppending)
    local now = os.time()
    local elapsed = now - lastFetchTimestamp
    if elapsed < FETCH_COOLDOWN then
        local waitSec = math.ceil(FETCH_COOLDOWN - elapsed)
        showNotification("Cooldown", "Please wait " .. waitSec .. "s before scanning again (Roblox rate limit)", 2)
        FooterText.Text = "Cooldown: Please wait " .. waitSec .. "s before refreshing..."
        return
    end

    if isLoading then
        return
    end

    isLoading = true
    RefreshButton.Text = "⏳ Querying..."
    RefreshButton.BackgroundColor3 = Color3.fromRGB(120, 120, 120)
    FooterText.Text = "Status: Contacting Roblox servers API for Place " .. tostring(TARGET_PLACE_ID) .. "..."

    task.spawn(function()
        local url = "https://games.roblox.com/v1/games/" .. tostring(TARGET_PLACE_ID) .. "/servers/Public?sortOrder=Asc&limit=100"
        if cursorToLoad and #cursorToLoad > 0 then
            url = url .. "&cursor=" .. HttpService:UrlEncode(cursorToLoad)
        end

        local success, responseBody = makeHttpRequest(url)

        if not success then
            isLoading = false
            RefreshButton.Text = "🔄 Scan Servers"
            RefreshButton.BackgroundColor3 = Color3.fromRGB(245, 158, 11)

            if responseBody == "RATE_LIMIT" then
                showNotification("Rate Limited", "Roblox API rate limited. Please wait 15s before refreshing.", 4)
                FooterText.Text = "Status: Roblox rate limited (429). Please wait ~15s."
            else
                showNotification("Fetch Error", "Roblox API error: " .. tostring(responseBody), 4)
                FooterText.Text = "Status: API Error (" .. tostring(responseBody) .. ")"
            end
            return
        end

        local decodeSuccess, decodedData = pcall(function()
            return HttpService:JSONDecode(responseBody)
        end)

        if not decodeSuccess or not decodedData or not decodedData.data then
            isLoading = false
            RefreshButton.Text = "🔄 Scan Servers"
            RefreshButton.BackgroundColor3 = Color3.fromRGB(245, 158, 11)
            showNotification("Decode Error", "Could not parse server list JSON", 3)
            FooterText.Text = "Status: Invalid JSON response from Roblox"
            return
        end

        lastFetchTimestamp = os.time()
        nextCursor = decodedData.nextPageCursor or ""
        previousCursor = decodedData.previousPageCursor or ""

        local newServers = {}
        for _, s in ipairs(decodedData.data) do
            if s.id then
                table.insert(newServers, {
                    id = tostring(s.id),
                    maxPlayers = tonumber(s.maxPlayers) or 7,
                    playing = tonumber(s.playing) or 0,
                    fps = math.floor((tonumber(s.fps) or 60) * 10) / 10,
                    ping = math.floor(tonumber(s.ping) or 0)
                })
            end
        end

        if isAppending then
            local seen = {}
            for _, existing in ipairs(cachedServers) do
                seen[existing.id] = true
            end
            for _, ns in ipairs(newServers) do
                if not seen[ns.id] then
                    table.insert(cachedServers, ns)
                end
            end
        else
            cachedServers = newServers
        end

        isLoading = false
        RefreshButton.Text = "🔄 Scan Servers"
        RefreshButton.BackgroundColor3 = Color3.fromRGB(245, 158, 11)

        if #nextCursor > 0 then
            NextPageButton.Text = "⏩ Load More Servers"
            NextPageButton.TextColor3 = Color3.fromRGB(220, 228, 245)
        else
            NextPageButton.Text = "✓ End of Server List"
            NextPageButton.TextColor3 = Color3.fromRGB(120, 130, 150)
        end

        renderServerList()
        showNotification("Success", "Loaded " .. tostring(#newServers) .. " real servers for Steal an Egg!", 3)
    end)
end

