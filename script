local function joinServerInstance(placeId, serverJobId)
    if not serverJobId or serverJobId == "" then
        showNotification("Error", "Invalid server Job ID", 3)
        return
    end

    if game.JobId and game.JobId == serverJobId then
        showNotification("Notice", "You are already connected to this server!", 3)
        return
    end

    showNotification("Teleporting", "Connecting to server: " .. string.sub(serverJobId, 1, 8) .. "...", 5)
    FooterText.Text = "Status: Teleporting to " .. string.sub(serverJobId, 1, 8) .. "..."

    local teleportSuccess, teleportError = pcall(function()
        TeleportService:TeleportToPlaceInstance(placeId, serverJobId, LocalPlayer)
    end)

    if not teleportSuccess then
        warn("[ServerFinder] Teleport failed:", teleportError)
        showNotification("Teleport Error", "Failed to initiate teleport: " .. tostring(teleportError), 4)
        FooterText.Text = "Status: Teleport failed (" .. tostring(teleportError) .. ")"
    end
end

pcall(function()
    TeleportService.TeleportInitFailed:Connect(function(player, teleportResult, errorMessage)
        if player == LocalPlayer then
            warn("[ServerFinder] Teleport Init Failed:", errorMessage)
            showNotification("Teleport Failed", "Roblox rejected connection: " .. tostring(errorMessage or teleportResult), 5)
            FooterText.Text = "Status: Server join failed (Full or Inaccessible)"
        end
    end)
