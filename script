-- ==================== CORE API & TELEPORT LOGIC ====================
local isQuerying = false

-- Resilient HTTP Request Engine (Prioritizes native game:HttpGet session, then requestMethod, with retry)
local function performRequest(url)
    -- 1. Try game:HttpGet first (Roblox internal client stack carries authentication & avoids 429)
    if typeof(game.HttpGet) == "function" then
        local ok, body = pcall(function()
            return game:HttpGet(url)
        end)
        if ok and body and string.find(body, "\"data\"") then
            return body, 200
        end
    end

    -- 2. Fallback to custom executor request functions
    local requestMethod = (syn and syn.request) or (http and http.request) or request or http_request
    if typeof(requestMethod) == "function" then
        local ok, res = pcall(requestMethod, {
            Url = url,
            Method = "GET",
            Headers = {
                ["User-Agent"] = "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36",
                ["Accept"] = "application/json"
            }
        })
        if ok and res then
            local statusCode = tonumber(res.StatusCode) or 200
            local body = res.Body or ""
            if statusCode == 200 and string.find(body, "\"data\"") then
                return body, 200
            end
            return body, statusCode
        end
    end

    return nil, 0
end

-- Robust Server Page Fetcher with Auto-Retry & Rate-Limit Backoff
local function fetchServerPage(cursor, retryCount)
    retryCount = retryCount or 3
    local query = (cursor and cursor ~= "") and ("&cursor=" .. cursor) or ""
    local baseUrl = "https://games.roblox.com/v1/games/" .. tostring(PlaceId) .. "/servers/Public?sortOrder=Asc&limit=" .. tostring(Config.SearchLimit) .. query

    for attempt = 1, retryCount do
        local raw, status = performRequest(baseUrl)
        if raw and status == 200 then
            local ok, decoded = pcall(function()
                return HttpService:JSONDecode(raw)
            end)
            if ok and decoded and decoded.data then
                return decoded, nil
            end
        end

        if status == 429 then
            setStatus(string.format("Menunggu antrian Roblox API (percobaan %d/%d)...", attempt, retryCount), Colors.Warning)
            task.wait(1.0 * attempt)
        else
            task.wait(0.4)
        end
    end

    -- Secondary fallback: Try without sortOrder=Asc if sortOrder query failed on this game
    local altUrl = "https://games.roblox.com/v1/games/" .. tostring(PlaceId) .. "/servers/Public?limit=" .. tostring(Config.SearchLimit) .. query
    local rawAlt, statusAlt = performRequest(altUrl)
    if rawAlt and statusAlt == 200 then
        local ok, decoded = pcall(function()
            return HttpService:JSONDecode(rawAlt)
        end)
        if ok and decoded and decoded.data then
            return decoded, nil
        end
    end

    return nil, "Gagal mengambil data dari Roblox API"
end


