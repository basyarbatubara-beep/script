-- Universal HTTP GET helper
local function makeHttpRequest(url)
    local requestFunc = (syn and syn.request)
        or (http and http.request)
        or http_request
        or (fluxus and fluxus.request)
        or request

    if requestFunc then
        local success, res = pcall(function()
            return requestFunc({
                Url = url,
                Method = "GET",
                Headers = {
                    ["Content-Type"] = "application/json",
                    ["Accept"] = "application/json",
                    ["User-Agent"] = "Roblox/WinInet"
                }
            })
        end)
        if success and res then
            if type(res) == "table" then
                if res.StatusCode == 200 or res.StatusMessage == "OK" then
                    return true, res.Body
                elseif res.StatusCode == 429 then
                    return false, "RATE_LIMIT"
                else
                    return false, "HTTP " .. tostring(res.StatusCode or res.StatusMessage)
                end
            elseif type(res) == "string" then
                return true, res
            end
        end
    end

    local httpGetSuccess, result = pcall(function()
        return game:HttpGet(url)
    end)
    if httpGetSuccess and result and #result > 0 then
        if string.find(result, '"code":0') and string.find(result, '"errors"') then
            return false, "RATE_LIMIT"
        end
        return true, result
    end

    return false, tostring(result or "Failed to fetch data")
end

-- Utility helpers
local function copyToClipboard(text)
    local setcb = setclipboard or toclipboard or (syn and syn.write_clipboard)
    if setcb then
        pcall(setcb, text)
        return true
    end
    return false
end

