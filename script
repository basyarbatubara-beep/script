local function getFilteredAndSortedServers()
    local result = {}
    local query = string.lower(string.gsub(searchQuery, "^%s*(.-)%s*$", "%1"))

    for _, s in ipairs(cachedServers) do
        local isCurrent = (game.JobId and game.JobId == s.id)
        if not (excludeCurrentServer and isCurrent) then
            local passesCount = true
            if activeFilter == "1" then
                passesCount = (s.playing <= 1)
            elseif activeFilter == "2" then
                passesCount = (s.playing == 2)
            elseif activeFilter == "3" then
                passesCount = (s.playing <= 3)
            end

            local passesSearch = true
            if #query > 0 then
                local idMatch = string.find(string.lower(s.id), query, 1, true) ~= nil
                local pingMatch = string.find(tostring(s.ping) .. "ms", query, 1, true) ~= nil
                local playMatch = string.find(tostring(s.playing), query, 1, true) ~= nil
                passesSearch = (idMatch or pingMatch or playMatch)
            end

            if passesCount and passesSearch then
                table.insert(result, s)
            end
        end
    end

    table.sort(result, function(a, b)
        if activeSort == "players_asc" then
            if a.playing == b.playing then
                return a.ping < b.ping
            end
            return a.playing < b.playing
        elseif activeSort == "ping_asc" then
            if a.ping == b.ping then
                return a.playing < b.playing
            end
            return a.ping < b.ping
        elseif activeSort == "fps_desc" then
            return a.fps > b.fps
        end
        return a.playing < b.playing
    end)

    return result
end

