    local query = (cursor and cursor ~= "") and ("&cursor=" .. cursor) or ""
    local url = "https://games.roblox.com/v1/games/" .. tostring(PlaceId) .. "/servers/Public?sortOrder=Asc&limit=" .. tostring(Config.SearchLimit) .. query

    local raw = fetchApi(url)
