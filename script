-- Server Query Action
local function queryServerList()
    if isQuerying then return end
    isQuerying = true
    RefreshBtn.Text = "Scanning..."
    setStatus("Querying public instances...", Colors.Warning)

    for _, child in ipairs(ServerScroll:GetChildren()) do
        if child:IsA("Frame") then child:Destroy() end
    end

    task.spawn(function()
        local cursor = nil
        local matches = {}
        local smallestFound = nil

        for page = 1, Config.MaxPages do
            setStatus(string.format("Scanning page %d...", page), Colors.Warning)
            local result, err = fetchServerPage(cursor)

            if not result then
                setStatus("Network query interrupted: " .. (err or "timeout"), Colors.Danger)
                break
            end

            for _, s in ipairs(result.data) do
                local p = tonumber(s.playing) or 0
                local maxP = tonumber(s.maxPlayers) or 0
                local sId = tostring(s.id)

                if sId ~= CurrentJobId and p > 0 and p < maxP then
                    if not smallestFound or p < (smallestFound.playing or 999) then
                        smallestFound = s
                    end

                    if p >= Config.MinPlayers and p <= Config.MaxPlayers then
                        table.insert(matches, s)
                    end
                end
            end

            cursor = result.nextPageCursor
            if not cursor or #matches >= 25 then
                break
            end

            task.wait(0.2 + math.random() * 0.1)
        end

        table.sort(matches, function(a, b)
            return (a.playing or 0) < (b.playing or 0)
        end)

        FoundLabel.Text = string.format("%d servers available", #matches)

        if #matches == 0 then
            if smallestFound then
                table.insert(matches, smallestFound)
                renderServerEntry(smallestFound, 1)
                setStatus(string.format("Strict threshold empty. Smallest found: %d players", smallestFound.playing), Colors.Warning)
            else
                setStatus("No active low-population instances found", Colors.Danger)
            end
        else
            for i, s in ipairs(matches) do
                renderServerEntry(s, i)
            end
            setStatus(string.format("Found %d servers matching filter", #matches), Colors.Success)
        end

        isQuerying = false
        RefreshBtn.Text = "Refresh"
    end)
end

-- Auto-Hop Action (Lowest population join)
local function executeQuickHop()
    if isQuerying then return end
    isQuerying = true
    AutoHopBtn.Text = "Scanning Cluster..."
    setStatus("Locating optimal low-pop instance...", Colors.Warning)

    task.spawn(function()
        local cursor = nil
        local candidates = {}
        local fallbackServer = nil

        for page = 1, Config.MaxPages do
            setStatus(string.format("Scanning cluster page %d...", page), Colors.Warning)
            local result, err = fetchServerPage(cursor)

            if not result then
                setStatus("Search error: " .. (err or "retry"), Colors.Danger)
                break
            end

            for _, s in ipairs(result.data) do
                local p = tonumber(s.playing) or 0
                local maxP = tonumber(s.maxPlayers) or 0
                local sId = tostring(s.id)

                if sId ~= CurrentJobId and p > 0 and p < maxP then
                    if not fallbackServer or p < (fallbackServer.playing or 999) then
                        fallbackServer = s
                    end

                    if p >= Config.MinPlayers and p <= Config.MaxPlayers then
                        table.insert(candidates, s)
                    end
                end
            end

            if #candidates > 0 then break end

            cursor = result.nextPageCursor
            if not cursor then break end

            task.wait(0.18 + math.random() * 0.1)
        end

        if #candidates == 0 and fallbackServer then
            table.insert(candidates, fallbackServer)
        end

        if #candidates == 0 then
            setStatus("No alternative servers located. Try raising filter.", Colors.Danger)
            isQuerying = false
            AutoHopBtn.Text = "Hop to Smallest Server"
            return
        end

        table.sort(candidates, function(a, b)
            return (a.playing or 0) < (b.playing or 0)
        end)

        for _, target in ipairs(candidates) do
            setStatus(string.format("Connecting to target instance (%d players)...", target.playing), Colors.Success)
            local ok = pcall(function()
                TeleportService:TeleportToPlaceInstance(PlaceId, target.id, LocalPlayer)
            end)

            if ok then
                task.wait(Config.RetryDelay + 1)
            else
                setStatus("Connection timed out, cycling candidate...", Colors.Warning)
                task.wait(Config.RetryDelay)
            end
        end

        isQuerying = false
        AutoHopBtn.Text = "Hop to Smallest Server"
    end)
end

