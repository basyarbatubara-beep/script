-- Safe GUI Parent helper
local function getGuiParent()
    local gethui = gethui or (syn and syn.protect_gui and function(g) syn.protect_gui(g); return game:GetService("CoreGui") end)
    if gethui then
        local h = gethui()
        if h then return h end
    end
    local coreGuiSuccess, coreGui = pcall(function()
        return game:GetService("CoreGui")
    end)
    if coreGuiSuccess and coreGui then
        return coreGui
    end
    return LocalPlayer:WaitForChild("PlayerGui")
end

