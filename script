-- Server Query Action (Server Browser)
local function queryServerList()
    if isQuerying then return end
    isQuerying = true
    RefreshBtn.Text = "Scanning..."
    setStatus("Memindai server publik...", Colors.Warning)

    for _, child in ipairs(ServerScroll:GetChildren()) do
        if child:IsA("Frame") then child:Destroy() end
    end

    task.spawn(function()
        local cursor = nil
        local matches = {}
        local allEligible = {}
        local onlyCurrentServer = true
        local scannedCount = 0

        for page = 1, Config.MaxPages do
            setStatus(string.format("Memindai halaman %d...", page), Colors.Warning)
            local result, err = fetchServerPage(cursor, 3)

            if not result or not result.data then
                if #allEligible > 0 then break end
                task.wait(1)
                result, err = fetchServerPage(cursor, 2)
                if not result or not result.data then break end
            end

            for _, s in ipairs(result.data) do
                scannedCount = scannedCount + 1
                local p = tonumber(s.playing) or 0
                local maxP = tonumber(s.maxPlayers) or 999
                if maxP <= 0 then maxP = 999 end
                local sId = tostring(s.id)

                if sId ~= CurrentJobId then
                    onlyCurrentServer = false
                    if p < maxP then
                        table.insert(allEligible, s)
                        if p >= Config.MinPlayers and p <= Config.MaxPlayers then
                            table.insert(matches, s)
                        end
                    end
                end
            end

            if #matches >= 25 then
                break
            end

            cursor = result.nextPageCursor
            if not cursor or cursor == "" then
                break
            end

            task.wait(0.35 + math.random() * 0.15)
        end

        table.sort(matches, function(a, b)
            return (a.playing or 0) < (b.playing or 0)
        end)
        table.sort(allEligible, function(a, b)
            return (a.playing or 0) < (b.playing or 0)
        end)

        if #matches > 0 then
            for i, s in ipairs(matches) do
                renderServerEntry(s, i)
                if i >= 30 then break end
            end
            FoundLabel.Text = string.format("%d servers available", #matches)
            setStatus(string.format("Ditemukan %d server sesuai filter (%d-%d pemain).", #matches, Config.MinPlayers, Config.MaxPlayers), Colors.Success)
        elseif #allEligible > 0 then
            -- Fallback: show the least populated servers found in the entire game
            for i, s in ipairs(allEligible) do
                renderServerEntry(s, i)
                if i >= 30 then break end
            end
            local bestCount = allEligible[1].playing or 0
            FoundLabel.Text = string.format("%d server (tersepi)", math.min(#allEligible, 30))
            setStatus(string.format("Server %d-%d pemain kosong. Menampilkan server paling sepi yang ada (mulai %d pemain).", Config.MinPlayers, Config.MaxPlayers, bestCount), Colors.Warning)
        else
            if onlyCurrentServer and scannedCount > 0 then
                setStatus("Hanya ada 1 server aktif di game ini (server kamu saat ini).", Colors.Warning)
            else
                setStatus("Tidak dapat mengambil server. Silakan coba klik Refresh lagi.", Colors.Danger)
            end
        end

        isQuerying = false
        RefreshBtn.Text = "Refresh"
    end)
end

-- Auto-Hop Action (ALWAYS FINDS A SMALL SERVER NO MATTER WHAT)
local function executeQuickHop()
    if isQuerying then return end
    isQuerying = true
    AutoHopBtn.Text = "Mencari Server Sepi..."
    setStatus("Memindai cluster server...", Colors.Warning)

    task.spawn(function()
        local cursor = nil
        local matchingServers = {}
        local allEligibleServers = {}
        local onlyCurrentServer = true
        local scannedCount = 0

        for page = 1, Config.MaxPages do
            setStatus(string.format("Memindai halaman cluster %d...", page), Colors.Warning)
            local result, err = fetchServerPage(cursor, 3)

            if not result or not result.data then
                if #allEligibleServers > 0 then break end
                task.wait(1)
                result, err = fetchServerPage(cursor, 2)
                if not result or not result.data then break end
            end

            for _, s in ipairs(result.data) do
                scannedCount = scannedCount + 1
                local p = tonumber(s.playing) or 0
                local maxP = tonumber(s.maxPlayers) or 999
                if maxP <= 0 then maxP = 999 end
                local sId = tostring(s.id)

                if sId ~= CurrentJobId then
                    onlyCurrentServer = false
                    if p < maxP then
                        table.insert(allEligibleServers, s)
                        if p >= Config.MinPlayers and p <= Config.MaxPlayers then
                            table.insert(matchingServers, s)
                        end
                    end
                end
            end

            -- If we found at least 1 server strictly matching threshold, we can hop immediately!
            if #matchingServers > 0 then
                break
            end

            cursor = result.nextPageCursor
            if not cursor or cursor == "" then
                break
            end

            task.wait(0.35 + math.random() * 0.15)
        end

        table.sort(matchingServers, function(a, b)
            return (a.playing or 0) < (b.playing or 0)
        end)
        table.sort(allEligibleServers, function(a, b)
            return (a.playing or 0) < (b.playing or 0)
        end)

        local targetList = {}
        local isFallback = false

        if #matchingServers > 0 then
            targetList = matchingServers
        elseif #allEligibleServers > 0 then
            -- "BAGIANMANAPUN JUGA SC HARUS CARI SERVER SEPI"
            -- Strict threshold had no servers, but we join the emptiest server available in the whole game!
            targetList = allEligibleServers
            isFallback = true
        end

        if #targetList == 0 then
            if onlyCurrentServer and scannedCount > 0 then
                setStatus("Hanya ada 1 server di game ini (server yang sedang kamu mainkan).", Colors.Warning)
            else
                setStatus("Gagal memindai server. Coba klik Hop sekali lagi.", Colors.Danger)
            end
            isQuerying = false
            AutoHopBtn.Text = "Hop to Smallest Server"
            return
        end

        local smallestPlayerCount = targetList[1].playing or 0
        if isFallback then
            setStatus(string.format("Server %d-%d tidak ada. Menghubungkan ke server paling sepi yang ada (%d pemain)...", Config.MinPlayers, Config.MaxPlayers, smallestPlayerCount), Colors.Accent)
        else
            setStatus(string.format("Ditemukan server sepi (%d pemain)! Menghubungkan...", smallestPlayerCount), Colors.Success)
        end

        -- Teleport with failover through targetList
        for idx, target in ipairs(targetList) do
            if idx > 1 then
                setStatus(string.format("Mencoba server cadangan (%d pemain)...", target.playing or 0), Colors.Warning)
            end

            local ok = pcall(function()
                TeleportService:TeleportToPlaceInstance(PlaceId, target.id, LocalPlayer)
            end)

            if ok then
                task.wait(Config.RetryDelay + 1)
            else
                task.wait(Config.RetryDelay)
            end
        end

        isQuerying = false
        AutoHopBtn.Text = "Hop to Smallest Server"
    end)
end

