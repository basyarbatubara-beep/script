-- Server Query Action
local function queryServerList()
    if isQuerying then return end
    isQuerying = true
    RefreshBtn.Text = "Scanning..."
    setStatus("Querying public instances...", Colors.Warning)

    for _, child in ipairs(ServerScroll:GetChildren()) do
        if child:IsA("Frame") then child:Destroy() end
    end

    task.spawn(function()
        local cursor = nil
        local found = {}
        local fallbackLowest = nil
        local matches = {}
        local smallestFound = nil

        for page = 1, Config.MaxPages do
            setStatus(string.format("Scanning halaman %d...", page), Palette.Yellow)
            local result, err = getServersPage(cursor)
            setStatus(string.format("Scanning page %d...", page), Colors.Warning)
            local result, err = fetchServerPage(cursor)

            if not result then
                setStatus("Error: " .. (err or "Gagal fetch"), Palette.Red)
                setStatus("Network query interrupted: " .. (err or "timeout"), Colors.Danger)
                break
            end

            for _, server in ipairs(result.data) do
                local playing = tonumber(server.playing) or 0
                local maxP = tonumber(server.maxPlayers) or 0
                local sId = tostring(server.id)
            for _, s in ipairs(result.data) do
                local p = tonumber(s.playing) or 0
                local maxP = tonumber(s.maxPlayers) or 0
                local sId = tostring(s.id)

                if sId ~= CurrentJobId and playing > 0 and playing < maxP then
                    if not fallbackLowest or playing < (fallbackLowest.playing or 999) then
                        fallbackLowest = server
                if sId ~= CurrentJobId and p > 0 and p < maxP then
                    if not smallestFound or p < (smallestFound.playing or 999) then
                        smallestFound = s
                    end

                    if playing >= Config.MinPlayers and playing <= Config.MaxPlayers then
                        table.insert(found, server)
                    if p >= Config.MinPlayers and p <= Config.MaxPlayers then
                        table.insert(matches, s)
                    end
                end
            end

            cursor = result.nextPageCursor
            if not cursor or #found >= 25 then
            if not cursor or #matches >= 25 then
                break
            end

            task.wait(0.2 + math.random() * 0.1)
        end

        table.sort(found, function(a, b)
        table.sort(matches, function(a, b)
            return (a.playing or 0) < (b.playing or 0)
        end)

        ServerCountLabel.Text = string.format("%d server ditemukan", #found)
        FoundLabel.Text = string.format("%d servers available", #matches)

        if #found == 0 then
            if fallbackLowest then
                table.insert(found, fallbackLowest)
                renderServerCard(fallbackLowest, 1)
                setStatus(string.format("Target ketat kosong. Server tersepi ditemukan: %d pemain.", fallbackLowest.playing), Palette.Yellow)
        if #matches == 0 then
            if smallestFound then
                table.insert(matches, smallestFound)
                renderServerEntry(smallestFound, 1)
                setStatus(string.format("Strict threshold empty. Smallest found: %d players", smallestFound.playing), Colors.Warning)
            else
                setStatus("Tidak ada server sepi ditemukan. Coba naikkan filter.", Palette.Red)
                setStatus("No active low-population instances found", Colors.Danger)
            end
        else
            for idx, s in ipairs(found) do
                renderServerCard(s, idx)
            for i, s in ipairs(matches) do
                renderServerEntry(s, i)
            end
            setStatus(string.format("Selesai! Ditemukan %d server sesuai filter.", #found), Palette.Green)
            setStatus(string.format("Found %d servers matching filter", #matches), Colors.Success)
        end

        isSearching = false
        ScanBtn.Text = "🔍 Cari Daftar Server"
        isQuerying = false
        RefreshBtn.Text = "Refresh"
    end)
end

